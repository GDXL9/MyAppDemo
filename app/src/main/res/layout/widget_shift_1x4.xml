<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="4dp"
    android:background="@drawable/bg_widget">

    <LinearLayout
        android:id="@+id/day1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/day1Name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="一"
            android:textSize="10sp"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/day1Date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4/29"
            android:textSize="12sp"
            android:textColor="@color/black"
            android:paddingTop="2dp" />

        <TextView
            android:id="@+id/day1Shift"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="白"
            android:textSize="10sp"
            android:textColor="@color/black"
            android:paddingTop="2dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/day2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/day2Name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="二"
            android:textSize="10sp"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/day2Date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4/30"
            android:textSize="12sp"
            android:textColor="@color/black"
            android:paddingTop="2dp" />

        <TextView
            android:id="@+id/day2Shift"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="夜"
            android:textSize="10sp"
            android:textColor="@color/black"
            android:paddingTop="2dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/day3"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/day3Name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="三"
            android:textSize="10sp"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/day3Date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5/1"
            android:textSize="12sp"
            android:textColor="@color/black"
            android:paddingTop="2dp" />

        <TextView
            android:id="@+id/day3Shift"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="休"
            android:textSize="10sp"
            android:textColor="@color/black"
            android:paddingTop="2dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/day4"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/day4Name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="四"
            android:textSize="10sp"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/day4Date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5/2"
            android:textSize="12sp"
            android:textColor="@color/black"
            android:paddingTop="2dp" />

        <TextView
            android:id="@+id/day4Shift"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="白"
            android:textSize="10sp"
            android:textColor="@color/black"
            android:paddingTop="2dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/day5"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/day5Name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="五"
            android:textSize="10sp"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/day5Date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5/3"
            android:textSize="12sp"
            android:textColor="@color/black"
            android:paddingTop="2dp" />

        <TextView
            android:id="@+id/day5Shift"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="夜"
            android:textSize="10sp"
            android:textColor="@color/black"
            android:paddingTop="2dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/day6"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/day6Name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="六"
            android:textSize="10sp"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/day6Date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5/4"
            android:textSize="12sp"
            android:textColor="@color/black"
            android:paddingTop="2dp" />

        <TextView
            android:id="@+id/day6Shift"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="白"
            android:textSize="10sp"
            android:textColor="@color/black"
            android:paddingTop="2dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/day7"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/day7Name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="日"
            android:textSize="10sp"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/day7Date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5/5"
            android:textSize="12sp"
            android:textColor="@color/black"
            android:paddingTop="2dp" />

        <TextView
            android:id="@+id/day7Shift"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="休"
            android:textSize="10sp"
            android:textColor="@color/black"
            android:paddingTop="2dp" />

    </LinearLayout>

</LinearLayout>