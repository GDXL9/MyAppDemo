<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/white">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:src="@drawable/ic_chevron_left"
            android:text="@string/back"
            android:textSize="12sp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/shift_scheduling"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />

    </LinearLayout>

    <!-- 基准日期设置 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="基准日期（第一个班次的起始日期）"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <Button
            android:id="@+id/btnBaseDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2026年4月25日"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- 班次周期设置 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="班次周期（用逗号分隔，如：白,夜,休）"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/editShiftCycle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="白,夜,休,白,夜,休,休,休"
        android:inputType="text"
        android:textSize="16sp"
        android:padding="12dp"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="8dp" />

    <!-- 周期预览 -->
    <TextView
        android:id="@+id/tvCyclePreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="当前周期：8天一循环"
        android:textSize="13sp"
        android:textColor="#999999"
        android:layout_marginBottom="24dp" />

    <!-- 保存按钮 -->
    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="保存设置"
        android:textSize="16sp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp" />

</LinearLayout>
