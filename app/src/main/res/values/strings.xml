<?xml version="1.0" encoding="utf-8"?>
<!--
    =============================================================================
    综合UI文案配置文件 (strings.xml)
    =============================================================================
    用途：统一管理应用内所有可见文字，便于多语言适配和集中修改。
    原则：
      1. 所有布局文件和代码中不得出现硬编码中文字符串，一律引用此处定义。
      2. 命名规范：使用小写下划线命名，按功能模块分组。
      3. 同一语义在不同位置的复用文案使用同一字符串资源。
    =============================================================================
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ==================== 应用级 (App Level) ==================== -->
    <string name="app_name">排班App</string>

    <!-- ==================== 通用按钮 (Common Buttons) ==================== -->
