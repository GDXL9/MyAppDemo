    <string name="week_wednesday">三</string>
    <string name="week_thursday">四</string>
    <string name="week_friday">五</string>
    <string name="week_saturday">六</string>
    <string name="week_sunday">日</string>

    <!-- ==================== 设置页面 (Settings Activity) ==================== -->
    <string name="shift_scheduling">班次排列</string>
    <string name="setting_base_date_label">基准日期（第一个班次的起始日期）</string>
